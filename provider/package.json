{
  "name": "agent-headunit",
  "version": "0.0.1",
  "license": "MIT",
  "repository": "github:zappybiby/agent-headunit",
  "description": "agent-headunit brings agent-device’s snapshots, selectors, and controls to the live Android Auto screen in Open Headunit.",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./agent-device": "./index.mjs",
    "./http-auth": "./http-auth.mjs"
  },
  "bin": {
    "agent-headunit": "./cli/headunit.mjs",
    "install-headunit-provider": "./cli/install.mjs",
    "open-headunit-session": "./cli/session.mjs",
    "open-headunit-contact-sheet": "./cli/contact-sheet.mjs",
    "open-headunit-artifacts": "./cli/artifacts.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "windowsPython": ["3.15", "3.14", "3.13", "3.12"],
  "openHeadunit": {
    "repository": "andreknieriem/open-headunit",
    "package": "com.andrerinas.headunitrevived"
  },
  "files": [
    "*.mjs",
    "cli",
    "install_provider.py",
    "windows",
    "backend"
  ],
  "devDependencies": {
    "agent-device": "0.21.44"
  }
}
