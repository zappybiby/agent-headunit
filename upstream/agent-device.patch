+import { readFile, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { buffer } from 'node:stream/consumers';
+import { expect, test } from 'vitest';
+import { mkdtempForTest } from '@agent-device/test-kit';
+import { createRuntimeStateHandle } from '@agent-device/host-kit/runtime-slots';
+import {
+  listDownloadableArtifacts,
+  openDownloadableArtifact,
+  trackDownloadableArtifact,
+} from '../../resources/artifact-tracking.ts';
+import { retainProviderSessionOutputs } from '../session-output-artifacts.ts';
+
+test('the exact completed output stays available only to its tenant, lease and session', async () => {
+  const directory = await mkdtempForTest('provider-session-artifact-');
+  const source = path.join(directory, 'projection.png');
+  await writeFile(source, 'first capture');
+  const runtime = createRuntimeStateHandle();
+  const sessionScope = { leaseId: 'projection-lease', sessionName: 'drive' };
+  try {
+    await runtime.run(() => retainProviderSessionOutputs({
+      req: { token: 'local-test', command: 'screenshot', session: 'drive' },
+      data: { path: source },
+      session: { name: 'team:drive', sessionScope: { kind: 'tenant', id: 'team' } },
+      lease: { leaseId: sessionScope.leaseId, tenantId: 'team' },
+      track: trackDownloadableArtifact,
+    }));
+    await writeFile(source, 'next capture');
+    const list = (tenantId: string, scope?: typeof sessionScope) =>
+      runtime.run(() => listDownloadableArtifacts(tenantId, process.env, scope));
+    expect(await list('team')).toEqual([]);
+    expect(await list('another-team', sessionScope)).toEqual([]);
+    expect(await list('team', { ...sessionScope, sessionName: 'another' })).toEqual([]);
+    expect(await list('team', { ...sessionScope, leaseId: 'another' })).toEqual([]);
+    const artifacts = await list('team', sessionScope);
+    expect(artifacts).toEqual([
+      expect.objectContaining({
+        artifactType: 'screenshot',
+        filename: 'projection.png',
+        sessionName: 'drive',
+        sizeBytes: 13,
+      }),
+    ]);
+    const id = artifacts[0]!.id;
+    const open = (tenantId: string, scope?: typeof sessionScope) =>
+      runtime.run(() => openDownloadableArtifact(id, tenantId, process.env, undefined, scope));
+    await expect(open('team')).rejects.toMatchObject({ code: 'UNAUTHORIZED' });
+    await expect(open('another-team', sessionScope)).rejects.toMatchObject({ code: 'UNAUTHORIZED' });
+    await expect(open('team', { ...sessionScope, leaseId: 'another' })).rejects.toMatchObject({ code: 'UNAUTHORIZED' });
+    const download = await open('team', sessionScope);
+    try {
+      expect((await buffer(download.stream)).toString()).toBe('first capture');
+    } finally {
+      download.stream.destroy();
+      download.release();
+    }
+    expect(await readFile(source, 'utf8')).toBe('next capture');
+  } finally {
+    runtime.dispose();
+  }
+});
diff --git a/packages/daemon/src/server/session-output-artifacts.ts b/packages/daemon/src/server/session-output-artifacts.ts
new file mode 100644
index 0000000..00195ba
--- /dev/null
+++ b/packages/daemon/src/server/session-output-artifacts.ts
@@ -0,0 +1,101 @@
+import { randomUUID } from 'node:crypto';
+import { lstat, open, unlink } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { pipeline } from 'node:stream/promises';
+import type { Stats } from 'node:fs';
+import type { DaemonArtifact, DaemonResponseData } from '@agent-device/kernel/contracts';
+import { emitDiagnostic } from '@agent-device/host-kit/diagnostics';
+import { isRecord } from '@agent-device/kernel/record';
+import { getRequestSignal } from '@agent-device/host-kit/request';
+import type { DaemonRequest } from '../core/daemon-request.ts';
+import type { SessionLease } from '../core/lease-context.ts';
+import type { SessionState } from '../core/session-state.ts';
+import { tenantPublicSessionName } from '../core/session-tenant-scope.ts';
+import type { TrackDownloadableArtifact } from '../resources/artifact-tracking.ts';
+
+export async function retainProviderSessionOutputs(params: {
+  req: DaemonRequest;
+  data: DaemonResponseData;
+  session: Pick<SessionState, 'name' | 'sessionScope'>;
+  lease: Pick<SessionLease, 'leaseId' | 'tenantId'>;
+  track: TrackDownloadableArtifact;
+}): Promise<void> {
+  const { req, data, session, lease, track } = params;
+  const { leaseId, tenantId } = lease;
+  const sessionName = session.sessionScope?.kind === 'tenant'
+    ? tenantPublicSessionName(tenantId, session.name)
+    : session.name;
+  const signal = getRequestSignal(req.meta?.requestId);
+  for (const artifact of captureOutputs(req, data)) {
+    const source = artifact.path;
+    if (!source || !path.isAbsolute(source) || signal?.aborted) continue;
+    try {
+      await copyCompletedArtifact(source, signal, (artifactPath) => {
+        track({
+          artifactPath,
+          artifactType: artifact.artifactType,
+          fileName: path.basename(artifact.fileName ?? source),
+          tenantId,
+          sessionName,
+          sessionScope: { leaseId, sessionName },
+        });
+      });
+    } catch {
+      emitDiagnostic({ level: 'warn', phase: 'provider_session_artifact_retention_failed' });
+    }
+  }
+}
+
+function captureOutputs(req: DaemonRequest, data: DaemonResponseData): DaemonArtifact[] {
+  if (Array.isArray(data.artifacts) && data.artifacts.length > 0) return data.artifacts;
+  if (req.command === 'screenshot' && typeof data.path === 'string') {
+    return [{ field: 'path', artifactType: 'screenshot', path: data.path }];
+  }
+  if (req.command === 'perf') {
+    const detail = data.artifact;
+    if (isRecord(detail) && typeof detail.path === 'string') {
+      return [{ field: 'outPath', artifactType: 'performance', path: detail.path }];
+    }
+    const [area, operation, action] = (req.positionals ?? []).map((value) => value.toLowerCase());
+    if (
+      typeof data.outPath === 'string' &&
+      (action === 'report' || action === 'stop' || (area === 'trace' && operation === 'stop'))
+    ) return [{ field: 'outPath', artifactType: 'performance', path: data.outPath }];
+  }
+  return [];
+}
+
+async function copyCompletedArtifact(
+  sourcePath: string,
+  signal: AbortSignal | undefined,
+  publish: (path: string) => void,
+): Promise<void> {
+  const expected = await lstat(sourcePath);
+  if (!expected.isFile()) return;
+  const source = await open(sourcePath, 'r');
+  try {
+    if (!sameRevision(expected, await source.stat())) return;
+    const staged = path.join(os.tmpdir(), `agent-device-session-artifact-${randomUUID()}`);
+    const output = await open(staged, 'wx', 0o600);
+    let published = false;
+    try {
+      await pipeline(source.createReadStream(), output.createWriteStream(), { signal });
+      signal?.throwIfAborted();
+      if (!sameRevision(expected, await lstat(sourcePath))) return;
+      publish(staged);
+      published = true;
+    } finally {
+      await output.close();
+      if (!published) await unlink(staged);
+    }
+  } finally {
+    await source.close();
+  }
+}
+
+function sameRevision(expected: Stats, actual: Stats): boolean {
+  return actual.isFile() && expected.dev === actual.dev && expected.ino === actual.ino &&
+    expected.size === actual.size && expected.mtimeMs === actual.mtimeMs &&
+    expected.ctimeMs === actual.ctimeMs;
+}
diff --git a/packages/host-kit/src/internal/npm-command.ts b/packages/host-kit/src/internal/npm-command.ts
new file mode 100644
index 0000000..36633ee
--- /dev/null
+++ b/packages/host-kit/src/internal/npm-command.ts
@@ -0,0 +1,39 @@
+import path from 'node:path';
+import { AppError } from '@agent-device/kernel/errors';
+import type { EnvMap } from '@agent-device/kernel/source-value';
+import { hostFileStatSync } from './host-file.ts';
+import { hostNodeExecutablePath, hostPlatform } from './host-process.ts';
+
+export function npmCommand(
+  env: Readonly<EnvMap>,
+  args: string[],
+  hint: string,
+): { command: string; args: string[] } {
+  if (hostPlatform() !== 'win32') return { command: 'npm', args };
+  // Windows npm is a batch file. Run its JavaScript entry so arguments stay out of a shell.
+  const command = hostNodeExecutablePath();
+  const npmCliScript = resolveWindowsNpmCliScript(env, command);
+  if (!npmCliScript) {
+    throw new AppError('TOOL_MISSING', 'npm not found in PATH', { nodeExecPath: command, hint });
+  }
+  return { command, args: [npmCliScript, ...args] };
+}
+
+function resolveWindowsNpmCliScript(env: Readonly<EnvMap>, node: string): string | undefined {
+  const advertised = env.npm_execpath?.trim();
+  if (advertised) {
+    const scriptPath = path.resolve(advertised);
+    // pnpm and yarn advertise their own launcher through the same variable.
+    if (path.basename(scriptPath) === 'npm-cli.js' && isFile(scriptPath)) return scriptPath;
+  }
+  const bundled = path.join(path.dirname(node), 'node_modules', 'npm', 'bin', 'npm-cli.js');
+  return isFile(bundled) ? bundled : undefined;
+}
+
+function isFile(filePath: string): boolean {
+  try {
+    return hostFileStatSync(filePath).isFile();
+  } catch {
+    return false;
+  }
+}
