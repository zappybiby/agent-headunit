+      connection.write(JSON.stringify(request) + "\\n");''')
+    source = replace(source, '''      reject(new Error(`Cannot connect to daemon: ${error.message}`));''',
+                     '''      reject(Object.assign(new Error(`Cannot connect to daemon: ${error.message}`), { code: error.code }));''')
+    return replace(source, '''    connection.setTimeout(socketTimeout, () => {''', '''    if (windows) connection.once("close", () => {
+      reject(Object.assign(new Error("The Windows agent-cdp daemon closed without a response."), { code: "ECONNRESET" }));
+    });
+    connection.setTimeout(socketTimeout, () => {''')
+
+
+def patch_daemon(source):
+    source = replace(source, "// src/daemon.ts\nvar STATE_DIR", """// src/daemon.ts
+import { fileURLToPath as headunitFileURLToPath, pathToFileURL as headunitPathToFileURL } from "node:url";
+import { checkWindowsDaemonToken, createWindowsDaemonIpc, publishWindowsDaemonInfo } from "./headunit-ipc.js";
+var STATE_DIR""")
+    source = replace(source, '''    fs7.mkdirSync(STATE_DIR, { recursive: true });
+    const socketPath = getSocketPath();
+    if (fs7.existsSync(socketPath)) {''', '''    fs7.mkdirSync(STATE_DIR, { recursive: true, mode: 0o700 });
+    if (process.platform === "win32") {
+      this.headunitIpc = await createWindowsDaemonIpc(STATE_DIR);
+      if (!this.headunitIpc) return;
+    }
+    const socketPath = this.headunitIpc?.socketPath ?? getSocketPath();
+    if (!this.headunitIpc && fs7.existsSync(socketPath)) {''')
+    source = replace(source, '''      buildMtime = fs7.statSync(new URL(import.meta.url).pathname).mtimeMs;''', '''      buildMtime = fs7.statSync(headunitFileURLToPath(import.meta.url)).mtimeMs;''')
+    source = replace(source, '''    fs7.writeFileSync(getDaemonInfoPath(), JSON.stringify(info, null, 2));''', '''    if (this.headunitIpc) {
+      info.headunitToken = this.headunitIpc.headunitToken;
+      publishWindowsDaemonInfo(getDaemonInfoPath(), info);
+    } else {
+      fs7.writeFileSync(getDaemonInfoPath(), JSON.stringify(info, null, 2));
+    }''')
+    source = replace(source, '''      fs7.unlinkSync(getSocketPath());''', '''      if (!this.headunitIpc) fs7.unlinkSync(getSocketPath());''')
+    source = replace(source, '''      fs7.unlinkSync(getDaemonInfoPath());
+    } catch {
+    }
+  }
+  startIpc(socketPath)''', '''      const infoPath = getDaemonInfoPath();
+      if (!this.headunitIpc || JSON.parse(fs7.readFileSync(infoPath, "utf8")).headunitToken === this.headunitIpc.headunitToken) {
+        fs7.unlinkSync(infoPath);
+      }
+    } catch {
+    }
+    this.headunitIpc?.guard.close();
+  }
+  startIpc(socketPath)''')
+    source = replace(source, '''            const command = JSON.parse(line);
+            const responsePromise''', '''            const command = JSON.parse(line);
+            if (this.headunitIpc) {
+              if (!checkWindowsDaemonToken(command, this.headunitIpc.headunitToken)) {
+                connection.destroy();
+                return;
+              }
+              if (command.type === "headunit-shutdown") {
+                connection.end(JSON.stringify({ ok: true }) + "\\n", () => process.emit("SIGTERM"));
+                return;
+              }
+            }
+            const responsePromise''')
+    return replace(source, '''if (process.argv[1] && import.meta.url === new URL(process.argv[1], "file://").href) {''',
+                   '''if (process.argv[1] && import.meta.url === headunitPathToFileURL(process.argv[1]).href) {''')
+
+
+def prepare(package):
+    manifest = json.loads((package / "package.json").read_text(encoding="utf-8"))
+    if (manifest.get("name"), manifest.get("version"), manifest.get("license")) != ("agent-cdp", VERSION, "MIT"):
+        raise ValueError(f"A published agent-cdp {VERSION} MIT package is required.")
+    if not (package / "LICENSE").is_file():
+        raise ValueError("The agent-cdp package has no license file.")
+    directory = package / "dist"
+    bundles = (("bin.js", patch_client), ("cli.js", patch_client),
+               ("daemon.js", patch_daemon), ("index.js", patch_daemon))
+    contents = {name: replace(patch((directory / name).read_text(encoding="utf-8")),
+                              f"//# sourceMappingURL={name}.map", "") for name, patch in bundles}
+    for name, source in contents.items():
+        (directory / name).write_text(source, encoding="utf-8", newline="\n")
+        (directory / (name + ".map")).unlink()
+    shutil.copyfile(Path(__file__).with_name("headunit-cdp-ipc.mjs"), directory / "headunit-ipc.js")
+
+
+if __name__ == "__main__":
+    prepare(Path(sys.argv[1]))
