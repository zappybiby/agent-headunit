+"""Patch the published agent-cdp 1.6.1 CLI and daemon for Windows IPC."""
+
+import json
+from pathlib import Path
+import shutil
+import sys
+
+
+VERSION = "1.6.1"
+
+
+def replace(source, original, replacement):
+    if source.count(original) != 1:
+        raise ValueError(f"The agent-cdp {VERSION} build changed near {original.splitlines()[0]!r}.")
+    return source.replace(original, replacement, 1)
+
+
+def patch_client(source):
+    source = replace(source, "// src/daemon-client.ts\nvar STATE_DIR", """// src/daemon-client.ts
+import { fileURLToPath as headunitFileURLToPath } from "node:url";
+import { isWindowsDaemonInfo, stopWindowsDaemon } from "./headunit-ipc.js";
+var STATE_DIR""")
+    source = replace(source, '''  cleanupDaemonState();
+  const daemonScript = path.join(path.dirname(new URL(import.meta.url).pathname), "daemon.js");''', '''  if (process.platform !== "win32") cleanupDaemonState();
+  const daemonScript = headunitFileURLToPath(new URL("./daemon.js", import.meta.url));''')
+    source = replace(source, '''    detached: true,
+    stdio: "ignore"''', '''    detached: true,
+    windowsHide: true,
+    stdio: "ignore"''')
+    source = replace(source, '''      await sendCommand({ type: "ping" });
+      return;''', '''      const response = await sendCommand({ type: "ping" }, process.platform === "win32" ? 350 : undefined);
+      if (process.platform !== "win32" || response.ok) return;''')
+    source = replace(source, '''async function ensureDaemon() {
+  const info = readDaemonInfo();''', '''async function ensureDaemon() {
+  const info = readDaemonInfo();
+  if (process.platform === "win32") {
+    if (isWindowsDaemonInfo(STATE_DIR, info)) {
+      const running = await sendCommand({ type: "ping" }, 350, info).then((r) => r.ok, () => false);
+      if (running && info.version === getPackageVersion()) return;
+      if (running) await stopWindowsDaemon(info, sendCommand, readDaemonInfo);
+    }
+    return await startDaemon();
+  }''')
+    source = replace(source, '''async function stopDaemon() {
+  const info = readDaemonInfo();''', '''async function stopDaemon() {
+  const info = readDaemonInfo();
+  if (process.platform === "win32") {
+    if (!isWindowsDaemonInfo(STATE_DIR, info)) return false;
