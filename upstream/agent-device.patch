+test.each([true, false])(
+  '--keep-session supports digest-bound resume after a divergence with surviving session %s',
+  async (survives) => {
+    const root = mkdtempForTestSync('agent-device-replay-resume-live-');
+    const sessionStore = new SessionStore(
+      path.join(root, 'sessions'),
+      createLiveTestHostEnvironment(),
+    );
+    const sessionName = 'projection';
+    const session = sessionStore.publish(sessionName, makeIosSession(sessionName));
+    const filePath = writeReplayFile(root, ['open "Demo"', 'click "Dialog action"', 'close']);
+    const logPath = path.join(root, 'daemon.log');
+    let fails = true;
+    const invoke = vi.fn(async (req: DaemonRequest) => {
+      if (req.command !== 'click' || !fails) return { ok: true as const, data: {} };
+      if (!survives) sessionStore.retire(session);
+      return {
+        ok: false as const,
+        error: { code: 'COMMAND_FAILED' as const, message: 'Dialog is absent' },
+      };
+    });
+    const run = async (flags: DaemonRequest['flags'] = {}) =>
+      await runReplayForTest({
+        req: baseReq({
+          session: sessionName,
+          positionals: [filePath],
+          flags: { ...flags, replayKeepSession: true },
+        }),
+        sessionName,
+        logPath,
+        sessionStore,
+        invoke,
+      });
+
+    const failure = await run();
+    expect(failure).toMatchObject({ ok: false, error: { code: 'REPLAY_DIVERGENCE' } });
+    if (failure.ok) throw new Error('Expected replay divergence');
+    expect(failure.error.details?.activeReplaySession).toBe(survives ? sessionName : undefined);
+    if (!survives) return;
+
+    const divergence = failure.error.details?.divergence as {
+      resume: { allowed: boolean; from: number; planDigest: string };
+    };
+    expect(divergence.resume).toMatchObject({ allowed: true, from: 2 });
+    const { from: replayFrom, planDigest: replayPlanDigest } = divergence.resume;
+    invoke.mockClear();
+    fails = false;
+    await expect(run({ replayFrom, replayPlanDigest: '0'.repeat(64) })).resolves.toMatchObject({
+      ok: false,
+      error: { code: 'INVALID_ARGS' },
+    });
+    expect(invoke).not.toHaveBeenCalled();
+    await expect(run({ replayFrom, replayPlanDigest })).resolves.toMatchObject({
+      ok: true,
+      data: { session: sessionName, sessionActive: true, replayed: 1 },
+    });
+    expect(invoke.mock.calls.map(([req]) => req.command)).toEqual(['click']);
+    expect(sessionStore.lookup(sessionName)?.lifetime).toBe(session.lifetime);
+  },
+);
