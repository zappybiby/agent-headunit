diff --git a/scripts/headunit-cdp-ipc.mjs b/scripts/headunit-cdp-ipc.mjs
new file mode 100644
index 0000000..ba29887
--- /dev/null
+++ b/scripts/headunit-cdp-ipc.mjs
@@ -0,0 +1,74 @@
+import { createHash, randomBytes, timingSafeEqual } from 'node:crypto';
+import fs from 'node:fs';
+import net from 'node:net';
+import path from 'node:path';
+import { setTimeout as sleep } from 'node:timers/promises';
+
+function pipePrefix(directory) {
+  const scope = createHash('sha256')
+    .update(path.resolve(directory).toLowerCase())
+    .digest('hex')
+    .slice(0, 24);
+  return `\\\\.\\pipe\\headunit-agent-cdp-${scope}-`;
+}
+
+export function isWindowsDaemonInfo(directory, info) {
+  const prefix = pipePrefix(directory);
+  return (
+    typeof info?.socketPath === 'string' &&
+    info.socketPath.startsWith(prefix) &&
+    /^[a-f0-9]{32}$/.test(info.socketPath.slice(prefix.length)) &&
+    typeof info.headunitToken === 'string' &&
+    /^[a-f0-9]{64}$/.test(info.headunitToken)
+  );
+}
+
+export async function createWindowsDaemonIpc(directory) {
+  const prefix = pipePrefix(directory);
+  // The owner pipe fences concurrent starts. Commands use a separate random pipe and secret.
+  const guard = net.createServer((connection) => connection.destroy());
+  try {
+    await new Promise((resolve, reject) => {
+      guard.once('error', reject);
+      guard.listen(prefix + 'owner', resolve);
+    });
+  } catch (error) {
+    if (error.code === 'EADDRINUSE') return undefined;
+    throw error;
+  }
+  return {
+    guard,
+    socketPath: prefix + randomBytes(16).toString('hex'),
+    headunitToken: randomBytes(32).toString('hex'),
+  };
+}
+
+export function publishWindowsDaemonInfo(destination, info) {
+  const temporary = destination + '.' + randomBytes(8).toString('hex');
+  try {
+    fs.writeFileSync(temporary, JSON.stringify(info), { flag: 'wx', mode: 0o600, flush: true });
+    fs.renameSync(temporary, destination);
+  } finally {
+    fs.rmSync(temporary, { force: true });
+  }
+}
+
+export function checkWindowsDaemonToken(command, expected) {
+  const received = command?.headunitToken;
+  return (
+    typeof received === 'string' &&
+    /^[a-f0-9]{64}$/.test(received) &&
+    timingSafeEqual(Buffer.from(received, 'hex'), Buffer.from(expected, 'hex'))
+  );
+}
+
+export async function stopWindowsDaemon(info, send, read) {
+  const response = await send({ type: 'headunit-shutdown' }, 2000, info);
+  if (!response.ok) throw new Error('The agent-cdp daemon refused to shut down.');
+  const deadline = Date.now() + 5000;
+  do {
+    if (read()?.headunitToken !== info.headunitToken) return;
+    await sleep(50);
+  } while (Date.now() < deadline);
+  throw new Error('The agent-cdp daemon did not finish shutting down.');
+}
diff --git a/scripts/headunit-cdp-ipc.test.mjs b/scripts/headunit-cdp-ipc.test.mjs
new file mode 100644
index 0000000..e5a126f
--- /dev/null
+++ b/scripts/headunit-cdp-ipc.test.mjs
@@ -0,0 +1,106 @@
+import assert from 'node:assert/strict';
+import { execFile } from 'node:child_process';
+import { once } from 'node:events';
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { createServer } from 'node:http';
+import net from 'node:net';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { test } from 'node:test';
+import { promisify } from 'node:util';
+import { createWindowsDaemonIpc } from './headunit-cdp-ipc.mjs';
+
+const executable = process.env.HEADUNIT_CDP_TEST_BIN;
+const windows = process.platform === 'win32' && Boolean(executable);
+
+function session() {
+  const home = mkdtempSync(path.join(tmpdir(), 'agent cdp & scripts '));
+  const directory = path.join(home, '.agent-cdp');
+  const record = path.join(directory, 'daemon.json');
+  const run = (...args) =>
+    promisify(execFile)(process.execPath, [executable, ...args], {
+      env: { ...process.env, HOME: home },
+      timeout: 10000,
+      windowsHide: true,
+    });
+  return { home, directory, record, run };
+}
+
+test(
+  'Windows pinned CDP handles concurrent startup, target discovery, and authenticated shutdown',
+  { skip: !windows },
+  async () => {
+    const { home, record, run } = session();
+    const server = createServer((request, response) => {
+      if (request.url !== '/json/list') return response.writeHead(404).end();
+      response.setHeader('Content-Type', 'application/json');
+      response.end(
+        JSON.stringify([
+          {
+            id: 'fixture',
+            type: 'page',
+            title: 'Isolated CDP target',
+            url: 'about:blank',
+            webSocketDebuggerUrl: `ws://127.0.0.1:${server.address().port}/devtools/page/fixture`,
+          },
+        ]),
+      );
+    });
+    try {
+      server.listen(0, '127.0.0.1');
+      await once(server, 'listening');
+      const [, discovery] = await Promise.all([
+        run('status'),
+        run('target', 'list', '--url', `http://127.0.0.1:${server.address().port}`),
+      ]);
+      assert.match(discovery.stdout, /Isolated CDP target/);
+      const info = JSON.parse(readFileSync(record, 'utf8'));
+      assert.equal(info.version, '1.6.1');
+      const pipe = net.createConnection(info.socketPath, () =>
+        pipe.write('{"type":"headunit-shutdown"}\n'),
+      );
+      const replies = [];
+      pipe.on('data', (chunk) => replies.push(chunk));
+      await once(pipe, 'close');
+      assert.deepEqual(replies, []);
+      assert.match((await run('status')).stdout, /running/);
+      assert.equal(JSON.parse(readFileSync(record, 'utf8')).pid, info.pid);
+      assert.equal((await run('stop')).stdout.trim(), 'Daemon stopped');
+      assert.ok(!existsSync(record));
+    } finally {
+      if (existsSync(record)) await run('stop').catch(() => {});
+      await new Promise((resolve) => server.close(resolve));
+      rmSync(home, { recursive: true, force: true });
+    }
+  },
+);
+
+test(
+  'Windows CDP reports a pipe that closes before replying without waiting for its timeout',
+  { skip: !windows },
+  async () => {
+    const { directory, home, record, run } = session();
+    const endpoint = await createWindowsDaemonIpc(directory);
+    const peer = net.createServer((connection) => connection.once('data', () => connection.end()));
+    try {
+      peer.listen(endpoint.socketPath);
+      await once(peer, 'listening');
+      mkdirSync(directory);
+      writeFileSync(
+        record,
+        JSON.stringify({
+          pid: process.pid,
+          version: '1.6.1',
+          socketPath: endpoint.socketPath,
+          headunitToken: endpoint.headunitToken,
+        }),
+      );
+      assert.equal((await run('stop')).stdout.trim(), 'Daemon is not running');
+      assert.ok(existsSync(record));
+    } finally {
+      await new Promise((resolve) => peer.close(resolve));
+      await new Promise((resolve) => endpoint.guard.close(resolve));
+      rmSync(home, { recursive: true, force: true });
+    }
+  },
+);
