new file mode 100644
index 0000000..445e6cc
--- /dev/null
+++ b/packages/provider-webdriver/src/webdriver-gesture-cancellation.test.ts
@@ -0,0 +1,88 @@
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { createServer, type ServerResponse } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { buildGesturePlan } from '@agent-device/gestures/gesture-plan';
+import { test } from 'vitest';
+import { createCloudWebDriverCapabilities } from './capabilities.ts';
+import { WebDriverClient } from './webdriver-client.ts';
+import { createWebDriverInteractor } from './webdriver-interactor.ts';
+
+function deferred<T>(): { promise: Promise<T>; resolve: (value: T) => void } {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+
+test('canceling a gesture closes the POST and waits for its independent DELETE', async () => {
+  const posted = deferred<void>();
+  const disconnected = deferred<void>();
+  const release = deferred<ServerResponse>();
+  const server = createServer((req, res) => {
+    req.resume();
+    req.once('end', () => {
+      if (req.method === 'POST' && req.url === '/session') {
+        res.end(JSON.stringify({ value: { sessionId: 'projection', capabilities: {} } }));
+      } else if (req.method === 'POST' && req.url === '/session/projection/actions') {
+        res.once('close', () => disconnected.resolve());
+        posted.resolve();
+      } else if (req.method === 'DELETE' && req.url === '/session/projection/actions') {
+        release.resolve(res);
+      } else {
+        res.writeHead(404).end();
+      }
+    });
+  }).listen(0, '127.0.0.1');
+  const controller = new AbortController();
+  try {
+    await once(server, 'listening');
+    const { port } = server.address() as AddressInfo;
+    const client = new WebDriverClient({
+      endpoint: `http://127.0.0.1:${port}/`,
+      clientVersion: '0.0.0-test',
+      requestPolicy: { timeoutMs: 1000 },
+    });
+    await client.createSession({});
+    const interactor = createWebDriverInteractor({
+      client,
+      backend: 'android',
+      capabilities: createCloudWebDriverCapabilities({ provider: 'test', platform: 'android' }),
+    });
+    const plan = buildGesturePlan(
+      { intent: 'pan', origin: { x: 100, y: 200 }, delta: { x: 100, y: 200 }, durationMs: 500 },
+      { x: 0, y: 0, width: 400, height: 800 },
+    );
+    let settled = false;
+    const pending = interactor.performGesture!(plan, controller.signal);
+    const settledGesture = pending.then(
+      () => {
+        settled = true;
+      },
+      () => {
+        settled = true;
+      },
+    );
+    assert.equal(
+      await Promise.race([posted.promise.then(() => 'posted'), settledGesture]),
+      'posted',
+    );
+    const reason = new Error('gesture request canceled');
+    controller.abort(reason);
+
+    const releaseResponse = await Promise.race([release.promise, settledGesture]);
+    assert.ok(releaseResponse, 'the gesture must still be awaiting the driver release');
+    assert.equal(
+      await Promise.race([disconnected.promise.then(() => 'disconnected'), settledGesture]),
+      'disconnected',
+    );
+    assert.equal(settled, false);
+    releaseResponse.end(JSON.stringify({ value: null }));
+    await assert.rejects(pending, (error: unknown) => error === reason);
+  } finally {
+    controller.abort();
+    server.closeAllConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+});
